{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/Umair-Qidwai-Resume.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Umair-Qidwai-Resume.pdf\""
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/resume",
      "destination": "/Umair-Qidwai-Resume.pdf",
      "permanent": false
    },
    {
      "source": "/resume.pdf",
      "destination": "/Umair-Qidwai-Resume.pdf",
      "permanent": false
    },
    {
      "source": "/assets/resume-:hash.pdf",
      "destination": "/Umair-Qidwai-Resume.pdf",
      "permanent": false
    },
    {
      "source": "/assets/resume-:hash/Umair-Qidwai-Resume.pdf",
      "destination": "/Umair-Qidwai-Resume.pdf",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
